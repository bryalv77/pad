{
  "rules": {
    ".read": false,
    ".write": false,
    "pads": {
      "$padId": {
        ".read": true,
        ".write": true,
        ".validate": "$padId.matches(/^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$/) && (!newData.exists() || newData.hasChildren(['content', 'createdAt', 'expiresAt', 'updatedAt']))",
        "content": { ".validate": "newData.isString() && newData.val().length <= 500000" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "expiresAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val() || (data.val() != 0 && data.val() <= now))"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
